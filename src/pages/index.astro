---
import Layout from "../layouts/Layout.astro";
---

<style is:global>
  /* Customize Markmap for Dark Mode */
  .markmap-node-text {
    fill: #e2e8f0 !important; /* slate-200 */
    font-family: ui-sans-serif, system-ui, sans-serif !important;
  }
  .markmap-node-circle {
    stroke: #94a3b8 !important;
  }
</style>

<Layout title="Mind Map Generator">
  <main class="container mx-auto px-4 py-8 max-w-7xl h-screen flex flex-col">
    <!-- Header -->
    <header class="text-center mb-8 shrink-0">
      <h1
        class="text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600 mb-2"
      >
        Mind Map Generator
      </h1>
      <p class="text-slate-400 text-lg">
        Turn any idea into a visual structure instantly with Gemini.
      </p>
    </header>

    <!-- Content Grid -->
    <div class="grid gap-6 lg:grid-cols-[350px_1fr] flex-1 min-h-0">
      <!-- Sidebar / Config -->
      <div
        class="flex flex-col bg-slate-800/50 backdrop-blur-lg border border-slate-700 p-6 rounded-2xl shadow-xl h-full overflow-y-auto"
      >
        <div class="space-y-6">
          <!-- API Key Input -->
          <div>
            <label
              for="apiKey"
              class="block text-sm font-medium text-slate-300 mb-2"
              >Gemini API Key</label
            >
            <input
              type="password"
              id="apiKey"
              placeholder="Enter your API Key"
              class="w-full px-4 py-3 bg-slate-900 border border-slate-700 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent outline-none transition-all text-slate-100 placeholder-slate-500 shadow-inner"
            />
            <p class="text-xs text-slate-500 mt-2">
              Key is stored locally in your browser.
              <a
                href="https://aistudio.google.com/app/apikey"
                target="_blank"
                class="text-purple-400 hover:text-purple-300 underline"
                >Get one here</a
              >.
            </p>
          </div>

          <!-- Topic Input -->
          <div class="flex-1 flex flex-col">
            <label
              for="topic"
              class="block text-sm font-medium text-slate-300 mb-2"
              >Topic / Content</label
            >
            <textarea
              id="topic"
              placeholder="Paste a book summary, meeting notes, or explore a topic like 'History of Rome'..."
              class="w-full h-40 lg:h-64 px-4 py-3 bg-slate-900 border border-slate-700 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent outline-none transition-all text-slate-100 placeholder-slate-500 resize-y shadow-inner"
            ></textarea>
          </div>

          <!-- Generate Button -->
          <button
            id="generateBtn"
            class="w-full py-4 px-6 bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 rounded-xl font-bold shadow-lg shadow-purple-900/20 transform transition-all active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-2 group"
          >
            <span>Generate Mind Map</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-5 h-5 group-hover:translate-x-1 transition-transform"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z"
              ></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Visualization Area -->
      <div
        class="bg-slate-800/50 backdrop-blur-lg border border-slate-700 rounded-2xl shadow-xl overflow-hidden relative flex flex-col min-h-[500px]"
        id="map-container"
      >
        <svg id="markmap" class="w-full h-full flex-1"></svg>

        <!-- Loading Overlay -->
        <div
          id="loading"
          class="hidden absolute inset-0 bg-slate-900/80 flex items-center justify-center backdrop-blur-sm z-10 flex-col gap-4"
        >
          <div
            class="animate-spin rounded-full h-12 w-12 border-4 border-purple-500 border-t-transparent shadow-lg shadow-purple-500/50"
          >
          </div>
          <p class="text-purple-300 font-medium animate-pulse">
            Dreaming up your map...
          </p>
        </div>

        <!-- Empty State -->
        <div
          id="empty-state"
          class="absolute inset-0 flex flex-col items-center justify-center text-slate-500 p-8 text-center pointer-events-none"
        >
          <div
            class="bg-slate-800 p-4 rounded-full mb-4 shadow-inner border border-slate-700"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-10 h-10 text-slate-600"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M7.5 14.25v2.25m3-2.25v2.25m3-2.25v2.25m-9 0h12m-9.969-3.375l1.59 1.59L18 8.01m-1.2 5.06l1.37-1.37a4.69 4.69 0 001.432-3.663c-.085-.62-.358-1.206-.793-1.666-.88-.937-2.316-.924-3.155.05L13.5 8.625l-.75-.75a3.493 3.493 0 000-4.94 3.493 3.493 0 00-4.94 0l-.75.75-2.148-2.147a2.215 2.215 0 00-3.172 0 2.215 2.215 0 000 3.172l2.147 2.147-3.66 3.663a4.72 4.72 0 000 6.696L3.375 20.25h13.5"
              ></path>
            </svg>
          </div>
          <p class="text-xl font-semibold mb-2 text-slate-400">
            Ready to Visualize
          </p>
          <p class="max-w-md">
            Enter a topic or paste content on the left, add your API key, and
            hit Generate.
          </p>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { GoogleGenerativeAI } from "@google/generative-ai";
  // @ts-ignore
  import { Transformer } from "markmap-lib";
  // @ts-ignore
  import { Markmap } from "markmap-view";
  // @ts-ignore
  import { Toolbar } from "markmap-toolbar";
  import "markmap-toolbar/dist/style.css";

  const apiKeyInput = document.getElementById("apiKey") as HTMLInputElement;
  const topicInput = document.getElementById("topic") as HTMLTextAreaElement;
  const generateBtn = document.getElementById(
    "generateBtn"
  ) as HTMLButtonElement;
  const loading = document.getElementById("loading");
  const emptyState = document.getElementById("empty-state");
  const svg = document.getElementById("markmap") as unknown as SVGElement;
  const mapContainer = document.getElementById("map-container");

  // Load saved key
  const savedKey = localStorage.getItem("gemini_api_key");
  if (savedKey) apiKeyInput.value = savedKey;

  const transformer = new Transformer();
  let markmapInstance: any = null;

  generateBtn?.addEventListener("click", async () => {
    const apiKey = apiKeyInput.value.trim();
    const topic = topicInput.value.trim();

    if (!apiKey) {
      alert("Please enter a Gemini API Key");
      return;
    }
    if (!topic) {
      alert("Please enter a topic");
      return;
    }

    localStorage.setItem("gemini_api_key", apiKey);

    loading?.classList.remove("hidden");
    generateBtn.disabled = true;
    emptyState?.classList.add("hidden");

    try {
      const genAI = new GoogleGenerativeAI(apiKey);
      const model = genAI.getGenerativeModel({ model: "gemini-2.0-flash-exp" });

      const prompt = `Create a comprehensive and structured mind map about: "${topic}". 
      
      Instructions:
      1. Use a central, core idea as the root.
      2. Branch out into main categories, then sub-categories.
      3. Format the output STRICTLY as Markdown suitable for Markmap.
         - Use '#' for the root node.
         - Use '##', '###', etc. for deeper levels.
         - Use '-' for list items if appropriate (though headings are preferred for structure in Markmap).
      4. You can include links using standard markdown syntax [text](url) if relevant.
      5. Do not include any conversational filler, intro, or outro. 
      6. Output ONLY the markdown.
      `;

      const result = await model.generateContent(prompt);
      const response = await result.response;
      let text = response.text();

      // Clean up markdown block markers
      text = text
        .replace(/^```markdown\s*/i, "")
        .replace(/^```\s*/i, "")
        .replace(/```\s*$/i, "");

      // Transform
      const { root } = transformer.transform(text);

      // Render
      if (markmapInstance) {
        markmapInstance.setData(root);
        markmapInstance.fit();
      } else {
        markmapInstance = Markmap.create(svg, undefined, root);

        // Add toolbar
        const toolbar = new Toolbar();
        toolbar.attach(markmapInstance);
        const el = toolbar.render();
        el.setAttribute(
          "style",
          "position:absolute;bottom:20px;right:20px;display:flex;gap:4px;"
        );
        mapContainer?.append(el);
      }
    } catch (error) {
      console.error(error);
      alert(
        "Error generating mind map. Check console for details. (Likely invalid API key or quota exceeded)"
      );
    } finally {
      loading?.classList.add("hidden");
      generateBtn.disabled = false;
    }
  });
</script>
